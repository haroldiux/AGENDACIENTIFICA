# ==============================================================================
# UNITEPC AGENDA CIENTÍFICA - VARIABLES DE ENTORNO
# Copia este archivo a `.env` en la raíz del proyecto para configurar tus credenciales
# ==============================================================================

# --- Puertos de Servicios ---
BACKEND_PORT=8005
FRONTEND_PORT=3005

# --- Base de Datos PostgreSQL y Redis ---
DATABASE_URL=postgresql://user:password@db:5432/agenda
REDIS_URL=redis://redis:6379/0

# --- URL del API para el Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8005/api/v1

# ==============================================================================
# CONFIGURACIÓN DE NOTIFICACIONES (EMAIL, WHATSAPP, TELEGRAM)
# ==============================================================================

# --- Correo Electrónico (SMTP - Gmail) ---
# Para Gmail:
# 1. Ve a tu cuenta de Google -> Seguridad -> Verificación en dos pasos (debe estar activa).
# 2. Al final de la página, entra a "Contraseñas de aplicaciones" (App Passwords).
# 3. Genera una contraseña con nombre "Agenda UNITEPC" (te dará un código de 16 letras).
# 4. Coloca tu correo en SMTP_USER y esa clave de 16 letras en SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
EMAILS_FROM_NAME="Agenda Científica UNITEPC"
EMAILS_FROM_EMAIL=tu-correo@gmail.com

# --- WhatsApp (Meta Cloud API / WhatsApp Business Platform) ---
# Requiere cuenta de desarrollador en https://developers.facebook.com:
# 1. Crea una app de tipo "Business" y añade el producto "WhatsApp".
# 2. En "API Setup", obtén el "Phone Number ID" y el "Access Token".
# 3. Para producción crea un "System User" con token permanente.
WHATSAPP_PHONE_ID=
WHATSAPP_API_TOKEN=

# --- Telegram (Opcional - Gratuito) ---
# 1. Habla con @BotFather en Telegram y crea un bot con /newbot.
# 2. Pega aquí el token que te entregue.
TELEGRAM_BOT_TOKEN=
